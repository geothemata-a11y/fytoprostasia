{"f":"70593","n":"RASSEL 100 SC","as":[{"n":"Florasulam","p":"10.0"}],"k":"HB","kn":"ΖΙΖΑΝΙΟΚΤΟΝΟ","m":"SC","s":"Μεταφυτρωτικό εκλεκτικό διασυστηματικό ζιζανιοκτόνο για την καταπολέμηση πλατύφυλλων ζιζανίων σε σιτηρά. Απορροφάται κυρίως από το φύλλωμα και μεταφέρεται γρήγορα σε όλο το φυτό. Η δραστική ουσία florasulam παρεμποδίζει τη δράση του ενζύμου οξειγαλακτική συνθετάση (acetolactate synthase – ALS) με αποτέλεσμα την παρεμπόδιση της βιοσύνθεσης των αμινοξέων και την αναστολή της ανάπτυξης των ζιζανίων μέσα στις επόμενες ημέρες από την εφαρμογή.","crops":[{"c":"1011000","n":"ΑΡΑΒΟΣΙΤΟΣ","phi":"","t":[{"t":"τάτουλας","d":"5","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"ψευδή χαμομήλι ή καπνόχορτο","d":"5","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"αγριομπαμπακιά","d":"5","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"τραχύ βλήτο","d":"5","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"αγριοντοματιά, στύφνος","d":"5","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"μεγαλόκαρπη κολλητσίδα","d":"5","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"Στελλάρια","d":"5","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"καψέλλα","d":"5","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"άγριο γογγύλι","d":"5","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"}]},{"c":"1012006","n":"ΣΙΤΑΡΙ ΜΑΛΑΚΟ ΧΕΙΜΕΡΙΝΟ","phi":"","t":[{"t":"Αγριο Φαγόπυρο","d":"5-6,5","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"κοινή παπαρούνα","d":"5-6,5","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"Στελλάρια","d":"5-6,5","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"καψέλλα","d":"5-6,5","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"κοινό χαμομήλι","d":"5-6,5","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"μεγαλόκαρπη κολλητσίδα","d":"5-6,5","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"}]}],"docs":[{"d":"2025-05-30","t":"Απόφαση έγκρισης (άρθρα 33 και 37§4)","u":"https://1click.minagric.gr/oneClickUI/oneClickFiles/RASSEL-100SC-70593.pdf","p":"144568"}]}