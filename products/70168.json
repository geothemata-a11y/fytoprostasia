{"f":"70168","n":"ALCANCE SYNCTEC","as":[{"n":"Pendimethalin","p":"29.8"},{"n":"Clomazone","p":"4.3"}],"k":"HB","kn":"ΖΙΖΑΝΙΟΚΤΟΝΟ","m":"CS","s":"Προφυτρωτικό ζιζανιοκτόνο για την καταπολέμηση αγρωστωδών και πλατυφύλλων ζιζανίων στην πατάτα και στην γλυκοπατάτα. Το Alcance® SYNC TEC είναι μίγμα δύο δραστικών συστατικών (clomazone+ pendimethalin). Το clomazone ειναι ενα διασυστηματικό ζιζανιοκτόνο που απορροφάται από τις ρίζες και τους βλαστούς και μετακινείται προς το πάνω μέρος του φυτού. Δρα παρεμποδίζοντας τη βιοσύνθεση των καροτινοειδών. Το pendimethalin δρα επηρεάζοντας τη λειτουργία της μίτωσης με παρεμπόδιση του σχηματισμού των μικροσωληνίσκων της μιτωτικής ατράκτου.","crops":[{"c":"1040400","n":"ΓΛΥΚΟΠΑΤΑΤΕΣ","phi":"","t":[{"t":"αιματόχορτο","d":"250","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"Μουχρίτσα","d":"250","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"κοινή πόα","d":"250","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"σπονδυλωτή σετάρια","d":"250","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"αγριομπαμπακιά","d":"250","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"τραχύ βλήτο","d":"250","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"λουβουδιά","d":"250","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"τάτουλας","d":"250","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"μεγαλόκαρπη κολλητσίδα","d":"250","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"πολυκόμπι","d":"250","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"γλυστρίδα (αντράκλα)","d":"250","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"περικοκλάδα ετήσια","d":"250","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"αγριοντοματιά, στύφνος","d":"250","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"ζωχός","d":"250","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"Αγριομελιτζάνα","d":"250","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"Αγρια ρόκα","d":"250","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"κοινή κολλιτσίδα βάλτου","d":"250","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"}]},{"c":"1041000","n":"ΠΑΤΑΤΕΣ","phi":"","t":[{"t":"αιματόχορτο","d":"250","u":"κυβ.εκ./στρέμ