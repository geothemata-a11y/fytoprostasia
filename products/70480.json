{"f":"70480","n":"ISERAN","as":[{"n":"Clomazone","p":"8.0"},{"n":"Mesotrione","p":"15.0"}],"k":"HB","kn":"ΖΙΖΑΝΙΟΚΤΟΝΟ","m":"ZC","s":"Εκλεκτικό προφυτρωτικό ή νωρίς μεταφυτρωτικό ζιζανιοκτόνο με υπολειμματική δράση για τον έλεγχο αγρωστωδών και πλατύφυλλων ζιζανίων στον αραβόσιτο. Το ISERAN είναι μίγμα δύο δραστικών ουσιών (clomazone + mesotrione). Η δ.ο. clomazone είναι διασυστηματικό ζιζανιοκτόνο που απορροφάται από τις ρίζες και τους βλαστούς των ζιζανίων στόχων και μετακινείται προς το μέρος του φυτού. Δρα αναστέλλοντας τη βιοσύνθεση της χλωροφύλλης και των καροτινοειδών. Η δ.ο. mesotrione παρεμποδίζει τη βιοσύνθεση των καροτινοειδών με δράση στο ένζυμο 4-HPPD.","crops":[{"c":"1011000","n":"ΑΡΑΒΟΣΙΤΟΣ","phi":"","t":[{"t":"Μουχρίτσα","d":"100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"αγριομπαμπακιά","d":"100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"βλήτο","d":"100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"λουβουδιά","d":"100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"πολυκόμπι","d":"100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"γλυστρίδα (αντράκλα)","d":"100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"αγριοπιπεριά","d":"100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"ραπανίδα","d":"100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"αγριοντοματιά, στύφνος","d":"100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"περικοκλάδα","d":"100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"}]}],"docs":[{"d":"2026-07-06","t":"Τροποποίηση — ημερομηνία λήξης","u":"https://1click.minagric.gr/oneClickUI/oneClickFiles/ISERAN-tr26-lhxh-70480.pdf","p":"179080"},{"d":"2024-11-29","t":"Τροποποίηση — ημερομηνία λήξης","u":"https://1click.minagric.gr/oneClickUI/oneClickFiles/ISERAN-tr24-lhxh-70480.pdf","p":"377608"},{"d":"2023-01-23","t":"Απόφαση έγκρισης (άρθρα 33 και 37§4)","u":"https://1click.minagric.gr/oneClickUI/oneClickFiles/ISERAN-ZC-70480.pdf","p":"718"}]}