{"f":"9067","n":"ISOMATE CTT","as":[{"n":"(E,E)-8,10-dodecadien-1-ol","p":"56.0"},{"n":"Tetradecan-1-ol","p":"6.9"},{"n":"dodecan-1-ol","p":"29.2"}],"k":"AT","kn":"ΕΝΤΟΜΟΕΛΚΥΣΤΙΚΗ","m":"VP","s":"Διαχυτήρες ελεγχόμενης απελευθέρωσης φερομόνης για την παρεμπόδιση της σύζευξης της καρπόκαψας (Cydia pomonella) σε μηλιά, αχλαδιά, καρυδιά, κυδωνιά και αχλαδομηλιά. Η φερομόνη προσελκύει τα αρσενικά ακμαία άτομα του εντόμου-στόχου παρεμποδίζοντας έτσι τη σύζευξη. Το προιόν επιδρά μόνο στα αρσενικά ακμαία άτομα και δεν έχει καμία επίδραση στα θηλυκά ακμαία, τα αυγά ή τις προνύμφες.","crops":[{"c":"1100100","n":"ΑΧΛΑΔΙΑ","phi":"","t":[{"t":"Καρπόκαψα","d":"50","u":"διαχυτήρες/στρέμμα","c":"Έντομα"},{"t":"Cydia pomonella","d":"50","u":"","c":"Έντομα"}]},{"c":"1100700","n":"ΑΧΛΑΔΟΜΗΛΙΑ","phi":"","t":[{"t":"Καρπόκαψα","d":"50","u":"διαχυτήρες/στρέμμα","c":"Έντομα"},{"t":"Cydia pomonella","d":"50","u":"","c":"Έντομα"}]},{"c":"1110100","n":"ΚΑΡΥΔΙΑ","phi":"","t":[{"t":"Καρπόκαψα","d":"50","u":"διαχυτήρες/στρέμμα","c":"Έντομα"},{"t":"Cydia pomonella","d":"50","u":"","c":"Έντομα"}]},{"c":"1100300","n":"ΚΥΔΩΝΙΑ","phi":"","t":[{"t":"Καρπόκαψα","d":"50","u":"διαχυτήρες/στρέμμα","c":"Έντομα"},{"t":"Cydia pomonella","d":"50","u":"","c":"Έντομα"}]},{"c":"1100500","n":"ΜΗΛΙΑ","phi":"","t":[{"t":"Καρπόκαψα","d":"50","u":"διαχυτήρες/στρέμμα","c":"Έντομα"},{"t":"Cydia pomonella","d":"50","u":"","c":"Έντομα"}]}],"docs":[{"d":"2025-11-03","t":"Τροποποίηση — διεύρυνση φάσματος σε ήσσονος σημασίας χρήσεις, τελευταία επέμβαση πριν τη συγκομιδή (άρθρο 51)","u":"https://1click.minagric.gr/oneClickUI/oneClickFiles/ISOMATE-CTT-tr25-fasma-minor-pHI-9067.pdf","p":"302748"},{"d":"2025-06-29","t":"Ανανέωση της έγκρισης (άρθρο 43)","u":"https://1click.minagric.gr/oneClickUI/oneClickFiles/ISOMATE-CTT-tr25-ananeosi-9067.pdf","p":"262588"},{"d":"2022-06-30","t":"Τροποποίηση — ημερομηνία λήξης","u":"https://1click.minagric.gr/oneClickUI/oneClickFiles/ISOMATE-CTT-tr22-lhxh-9067.pdf","p":"6259"},{"d":"2022-05-16