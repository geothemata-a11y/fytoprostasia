{"f":"3056","n":"NEMguard granules","as":[{"n":"Garlic extract","p":"45.0"}],"k":"NE","kn":"ΝΗΜΑΤΩΔΟΚΤΟΝΟ","m":"GR","s":"Νηματωδοκτόνο που δρα κατά των πρώιμων σταδίων (πρώτου και δεύτερου) των νηματωδών που ζουν ελεύθερα στο έδαφος, πριν εισέλθουν στο ξενιστή φυτό, μέσω της αναστολής των αναπνευστικών ενζύμων, προκαλώντας κυτταροτοξικές διαταραχές. Λόγω της φυτικής προέλευσης τους, τα συστατικά του εκχυλίσματος σκόρδου δρουν με διάφορους τρόπους επί των φυτικών παρασίτων. Το διαλλυλο-δισουλφίδιο και το διαλλυλο-τρισουλφίδιο έχει καταδειχτεί ότι αναστέλλουν την παραγωγή ακετυλοχολινεστεράσης. Η διαταραχή της λειτουργίας των ενζύμων οφείλεται πιθανόν στις εξαιρετικά δραστικές πολυσουλφιδικές ομάδες, οι οποίες μπορούν να προκαλέσουν ενζυματική παρεμπόδιση μέσω διαδικασίας εισαγωγής σταυροδεσμών με θειολικές ομάδες στα ένζυμα, μεταβάλλοντας έτσι – κατά κρίσιμο τρόπο – τη δομή στο χώρο.","crops":[{"c":"1062200","n":"ΑΝΤΙΔΙΑ ΘΕΡΜΟΚΗΠΙΟΥ","phi":"","t":[{"t":"Κομβονηματώδεις","d":"2-2,5","u":"g/στρέμμα","c":"Νηματώδεις"},{"t":"Tylenchida","d":"2-2,5","u":"","c":"Νηματώδεις"}]},{"c":"1053900","n":"ΑΝΤΙΔΙΑ ΥΠΑΙΘΡΟΥ","phi":"","t":[{"t":"Κομβονηματώδεις","d":"2-2,5","u":"g/στρέμμα","c":"Νηματώδεις"},{"t":"Tylenchida","d":"2-2,5","u":"","c":"Νηματώδεις"}]},{"c":"1064100","n":"ΓΑΙΟΚΑΡΔΑΜΟ ΘΕΡΜΟΚΗΠΙΟΥ","phi":"","t":[{"t":"Κομβονηματώδεις","d":"2-2,5","u":"g/στρέμμα","c":"Νηματώδεις"},{"t":"Tylenchida","d":"2-2,5","u":"","c":"Νηματώδεις"}]},{"c":"1057500","n":"ΓΑΙΟΚΑΡΔΑΜΟ ΥΠΑΙΘΡΟΥ","phi":"","t":[{"t":"Κομβονηματώδεις","d":"2-2,5","u":"g/στρέμμα","c":"Νηματώδεις"},{"t":"Tylenchida","d":"2-2,5","u":"","c":"Νηματώδεις"}]},{"c":"1064000","n":"ΚΑΡΔΑΜΟ ΘΕΡΜΟΚΗΠΙΟΥ","phi":"","t":[{"t":"Κομβονηματώδεις","d":"2-2,5","u":"g/στρέμμα","c":"Νηματώδεις"},{"t":"Tylenchida","d":"2-2,5","u":"","c":"Νηματώδεις"}]},{"c":"1055500","n":"ΚΑΡΔΑΜΟ ΥΠΑΙΘΡΟΥ","phi":"","t":[{"t":"Κομβονηματώδεις","d":"2-2,5","u":"g/στρέμμα","c":"Νηματώδεις"},{"t":"Tylenchida","d":"2-2,5","u":"","c":"Νηματώδεις"}]},{"c":"105