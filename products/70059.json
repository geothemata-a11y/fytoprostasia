{"f":"70059","n":"ALLIANCE WG","as":[{"n":"Metsulfuron-methyl","p":"6.0"},{"n":"Diflufenican","p":"60.0"}],"k":"HB","kn":"ΖΙΖΑΝΙΟΚΤΟΝΟ","m":"WG","s":"Ευρέως φάσματος μεταφυτρωτικό Ζιζανιοκτόνο για την αντιμετώπιση πλατυφύλλων ζιζανίων σε καλλιέργειες σιτηρών. Απορροφάται από το φύλλωμα και τις ρίζες. Δρα τόσο σε ζιζάνια που έχουν φυτρώσει κατά τη στιγμή της εφαρμογής, ενώ λόγω της υπολειμματικής διάρκειάς του ελέγχει και ζιζάνια που βλαστάνουν σε διάστημα μερικών εβδομάδων από την εφαρμογή. Σε βιοχημικό επίπεδο, το Diflufenican αναστέλλει τη βιοσύνθεση των καροτενοειδών, ενώ το Metsulfuron-methyl παρεμποδίζει τη δράση της συνθετάσης του οξειγαλακτικού (ALS).","crops":[{"c":"1010303","n":"ΚΡΙΘΑΡΙ ΧΕΙΜΕΡΙΝΟ","phi":"","t":[{"t":"κοινή παπαρούνα","d":"7,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"άγριο σινάπι","d":"7,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"Στελλάρια","d":"7,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"Βερόνικα","d":"7,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"κοινός αγριοπανσές","d":"7,5","u":"g/στρέμμα","c":"Ζιζάνια"}]},{"c":"1010503","n":"ΣΙΚΑΛΗ ΧΕΙΜΕΡΙΝΗ","phi":"","t":[{"t":"κοινή παπαρούνα","d":"7,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"άγριο σινάπι","d":"7,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"Στελλάρια","d":"7,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"Βερόνικα","d":"7,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"Πανσές","d":"7,5","u":"g/στρέμμα","c":"Ζιζάνια"}]},{"c":"1012005","n":"ΣΙΤΑΡΙ ΜΑΛΑΚΟ ΑΝΟΙΞΙΑΤΙΚΟ","phi":"","t":[{"t":"κοινή παπαρούνα","d":"7,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"άγριο σινάπι","d":"7,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"Στελλάρια","d":"7,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"Βερόνικα","d":"7,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"Πανσές","d":"7,5","u":"g/στρέμμα","c":"Ζιζάνια"}]},{"c":"1012006","n":"ΣΙΤΑΡΙ ΜΑΛΑΚΟ ΧΕΙΜΕΡΙΝΟ","phi":"","t":[{"t":"κοινή παπαρούνα","d":"7,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"άγριο σινάπι","d":"7,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"Στελλάρια","d":"7,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"Βερόνι