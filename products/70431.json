{"f":"70431","n":"QUELEX","as":[{"n":"Halauxifen-methyl","p":"11.2"},{"n":"Florasulam","p":"10.31"}],"k":"HB","kn":"ΖΙΖΑΝΙΟΚΤΟΝΟ","m":"WG","s":"Μεταφυτρωτικό εκλεκτικό διασυστηματικό ζιζανιοκτόνο για την καταπολέμηση πλατύφυλλων ζιζανίων σε σιτηρά, εσπεριδοειδή και ελιά. Η δραστική ουσία florasulam παρεμποδίζει τη δράση του ενζύμου οξεικογαλακτική συνθετάση (ALS). Η δραστική ουσία halauxifen-methyl μιμείται τη δράση της αυξητικής ορμόνης των ζιζανίων. Προκαλεί τη διατάραξη της φυσιολογικής ανάπτυξης των ζιζανίων, ιδιαίτερα κατά τη διαδικασία της κυτταρικής διαίρεσης. Η ανάπτυξη των ζιζανίων διακόπτεται και οδηγούνται στην νέκρωση. Ο χρόνος νέκρωσης ποικίλει από λίγες μέρες έως κάποιες εβδομάδες, ανάλογα με το είδος των ζιζανίων και των καιρικών συνθηκών. Πλήρης νέκρωση επέρχεται σε διάστημα 4-6 εβδομάδων.","crops":[{"c":"1010400","n":"ΒΡΩΜΗ","phi":"50.0","t":[{"t":"κοινό χαμομήλι","d":"3","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"καπνόχορτο","d":"3","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"μεγαλόκαρπη κολλητσίδα","d":"3","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"άγριο σινάπι","d":"3","u":"g/στρέμμα","c":"Ζιζάνια"}]},{"c":"1120100","n":"ΓΚΡΕΙΠ ΦΡΟΥΤ","phi":"7.0","t":[{"t":"πολυετής ζωχός","d":"6,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"ζωχός","d":"6,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"ερίγκερο, κόνιζα","d":"6,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"κόνυζα","d":"6,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"μολόχα","d":"6,5","u":"g/στρέμμα","c":"Ζιζάνια"}]},{"c":"1090000","n":"ΕΛΙΑ","phi":"7.0","t":[{"t":"μολόχα","d":"6,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"πολυετής ζωχός","d":"6,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"ζωχός","d":"6,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"χοιροβότανο","d":"6,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"τσουκνίδα","d":"6,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"Στελλάρια","d":"6,5","u":"g/στρέμμα","c":"Ζιζάνια"}]},{"c":"1010302","n":"ΚΡΙΘΑΡΙ ΑΝΟΙΞΙΑΤΙΚΟ","phi":"50.0","t":[{"t":"Αναγαλλίδα","d":"5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"λουβουδιά","d":"5","