{"f":"61180","n":"AVASTEL","as":[{"n":"Prothioconazole","p":"15.0"},{"n":"Fluxapyroxad","p":"7.5"}],"k":"FU","kn":"ΜΥΚΗΤΟΚΤΟΝΟ","m":"EC","s":"Διασυστηματικό μυκητοκτόνο με προστατευτική, θεραπευτική και μεγάλης διάρκειας δράση σε παθογόνα σιτηρών. Περιέχει τα δραστικά συστατικά prothioconazole και fluxapyroxad που δρούν με διαφορετικό τρόπο στα παθογόνα. Το prothioconazole ανήκει στην ομάδα των DMIs (υποομάδα τριαζόλες) και παρεμποδίζει τη βιοσύνθεση εργοστερόλης, ενώ το fluxapyroxad ανήκει στην ομάδα των καρβοξαμιδικών/SDHIs και παρεμποδίζει τη μεταφορά ηλεκτρονίων στο σύμλοκο ΙΙ της αναπνευστικής αλυσίδας. Απορροφάται γρήγορα από τους ιστούς του φυτού και μετακινείται διασυστηματικά προς τα νεαρά αναπτυσσόμενα όργανα παρέχοντας προστασία πριν και μετά την μόλυνση του φυτού από το παθογόνο.","crops":[{"c":"1010302","n":"ΚΡΙΘΑΡΙ ΑΝΟΙΞΙΑΤΙΚΟ","phi":"","t":[{"t":"Ρυγχοσπορίωση","d":"100-125","u":"κυβ.εκ./στρέμμα","c":"Ασθένειες (μύκητες και βακτήρια)"},{"t":"Ελμινθοσπορίωση","d":"100-125","u":"κυβ.εκ./στρέμμα","c":"Ασθένειες (μύκητες και βακτήρια)"},{"t":"Ωϊδιο","d":"100-125","u":"κυβ.εκ./στρέμμα","c":"Ασθένειες (μύκητες και βακτήρια)"},{"t":"Καστανή σκωρίαση","d":"100-125","u":"κυβ.εκ./στρέμμα","c":"Ασθένειες (μύκητες και βακτήρια)"},{"t":"Φουζάριο","d":"100-125","u":"κυβ.εκ./στρέμμα","c":"Ασθένειες (μύκητες και βακτήρια)"}]},{"c":"1010303","n":"ΚΡΙΘΑΡΙ ΧΕΙΜΕΡΙΝΟ","phi":"","t":[{"t":"Ρυγχοσπορίωση","d":"100-125","u":"κυβ.εκ./στρέμμα","c":"Ασθένειες (μύκητες και βακτήρια)"},{"t":"Ελμινθοσπορίωση","d":"100-125","u":"κυβ.εκ./στρέμμα","c":"Ασθένειες (μύκητες και βακτήρια)"},{"t":"Ωϊδιο","d":"100-125","u":"κυβ.εκ./στρέμμα","c":"Ασθένειες (μύκητες και βακτήρια)"},{"t":"Καστανή σκωρίαση","d":"100-125","u":"κυβ.εκ./στρέμμα","c":"Ασθένειες (μύκητες και βακτήρια)"},{"t":"Φουζάριο","d":"100-125","u":"κυβ.εκ./στρέμμα","c":"Ασθένειες (μύκητες και βακτήρια)"}]},{"c":"1012005","n":"ΣΙΤΑΡΙ ΜΑΛΑΚΟ ΑΝΟΙΞΙΑΤΙΚΟ","phi":"","t":[{"t":"Σεπτορίωση","d":"100-125","u":"κυβ.εκ./στρέμμα","c":"Α