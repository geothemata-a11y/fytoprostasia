{"f":"70590","n":"BEAM","as":[{"n":"Fenoxaprop-P","p":"6.9"}],"k":"HB","kn":"ΖΙΖΑΝΙΟΚΤΟΝΟ","m":"EW","s":"Μεταφυτρωτικό διασυστηματικό ζιζανιοκτόνο για την καταπολέμηση αγρωστωδών ζιζανίων σε σκληρό και μαλακό σιτάρι. Απορροφάται, κυρίως, από τα φύλλα και τον βλαστό και μεταφέρεται στις ρίζες και τα ριζώματα. Μετά την εφαρμογή οι νεότεροι ιστοί των φύλλων γίνονται χλωρωτικοί (κίτρινοι) ή νεκρωτικοί (καφέ) και τα φύλλα αποσχίζονται εύκολα. Το τελικό αποτέλεσμα είναι η νέκρωση των ζιζανίων.","crops":[{"c":"1012100","n":"ΣΙΤΑΡΙ ΜΑΛΑΚΟ","phi":"","t":[{"t":"σετάρια","d":"100-120","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"τραχεία λειβαδοπόα","d":"100-120","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"αλεπονουρές","d":"100-120","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"Αγριοβρώμες","d":"100-120","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"Ανεμόχορτο","d":"100-120","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"}]},{"c":"1012200","n":"ΣΙΤΑΡΙ ΣΚΛΗΡΟ","phi":"","t":[{"t":"σετάρια","d":"100-120","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"τραχεία λειβαδοπόα","d":"100-120","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"αλεπονουρές","d":"100-120","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"Αγριοβρώμες","d":"100-120","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"Ανεμόχορτο","d":"100-120","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"}]}],"docs":[{"d":"2025-05-08","t":"Απόφαση έγκρισης (άρθρα 33 & 34)","u":"https://1click.minagric.gr/oneClickUI/oneClickFiles/BEAM-EW-70590.pdf","p":"119891"}]}