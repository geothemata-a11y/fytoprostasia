{"f":"70465","n":"CLYDE","as":[{"n":"Florasulam","p":"25.0"}],"k":"HB","kn":"ΖΙΖΑΝΙΟΚΤΟΝΟ","m":"SG","s":"Εκλεκτικό διασυστηματικό μεταφυτρωτικό ζιζανιοκτόνο για την καταπολέμηση πλατύφυλλων ζιζανίων στα σιτηρά. Απορροφάται κυρίως από το φύλλωμα και δευτερευόντως από τις ρίζες των ζιζανίων και μετακινείται στα ακραία μεριστώματα, βλαστού και ρίζας παρεμποδίζοντας την ανάπτυξή τους. Δρα ως παρεμποδιστής του ενζύμου οξεικογαλακτική συνθετάση (ALS), με αποτέλεσμα την παρεμπόδιση της βιοσύνθεσης των αμινοξέων και την αναστολή της ανάπτυξης των ζιζανίων μέσα στις επόμενες ημέρες από την εφαρμογή. Καταστροφή των ευαίσθητων ειδών επέρχεται μέσα σε 2 έως 8 εβδομάδες ανάλογα με τις καλλιεργητικές συνθήκες.","crops":[{"c":"1010403","n":"ΒΡΩΜΗ ΧΕΙΜΕΡΙΝΗ","phi":"","t":[{"t":"μεγαλόκαρπη κολλητσίδα","d":"2-2,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"κοινή παπαρούνα","d":"2-2,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"Στελλάρια","d":"2-2,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"πολυετής ζωχός","d":"2-2,5","u":"g/στρέμμα","c":"Ζιζάνια"}]},{"c":"1010302","n":"ΚΡΙΘΑΡΙ ΑΝΟΙΞΙΑΤΙΚΟ","phi":"","t":[{"t":"μεγαλόκαρπη κολλητσίδα","d":"2-2,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"κοινή παπαρούνα","d":"2-2,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"Στελλάρια","d":"2-2,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"πολυετής ζωχός","d":"2-2,5","u":"g/στρέμμα","c":"Ζιζάνια"}]},{"c":"1010303","n":"ΚΡΙΘΑΡΙ ΧΕΙΜΕΡΙΝΟ","phi":"","t":[{"t":"μεγαλόκαρπη κολλητσίδα","d":"2-2,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"κοινή παπαρούνα","d":"2-2,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"Στελλάρια","d":"2-2,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"πολυετής ζωχός","d":"2-2,5","u":"g/στρέμμα","c":"Ζιζάνια"}]},{"c":"1010503","n":"ΣΙΚΑΛΗ ΧΕΙΜΕΡΙΝΗ","phi":"","t":[{"t":"μεγαλόκαρπη κολλητσίδα","d":"2-2,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"κοινή παπαρούνα","d":"2-2,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"Στελλάρια","d":"2-2,5","u":"g/στρέμμα","c":"Ζιζάνια"},{"t":"πολυετής ζωχός","d":"2-2,5","u":"g/στρέμμα","c":"Ζιζάνια"}]},{"c":"101