{"f":"70234","n":"BISMARK","as":[{"n":"Pendimethalin","p":"27.5"},{"n":"Clomazone","p":"5.5"}],"k":"HB","kn":"ΖΙΖΑΝΙΟΚΤΟΝΟ","m":"CS","s":"Ευρέως φάσματος προφυτρωτικό ζιζανιοκτόνο με υπολειμματική δράση για την αντιμετώπιση αγρωστωδών και πλατύφυλλων ζιζανίων σε πολλές καλλιέργειες. Το BISMARK είναι μίγμα δύο δραστικών ουσιών (clomazone + pendimethalin). Το clomazone είναι διασυστηματικό ζιζανιοκτόνο που απορροφάται από τις ρίζες και τους νεαρούς βλαστούς των ζιζανίων στόχων και μετακινείται στο πάνω μέρος του φυτού. Δρα αναστέλλοντας τη βιοσύνθεση των καροτινοειδών. Το pendimethalin δρα επηρεάζοντας τη λειτουργία της μίτωσης με παρεμπόδιση του σχηματισμού των μικροσωληνίσκων της μιτωτικής ατράκτου.","crops":[{"c":"1011000","n":"ΑΡΑΒΟΣΙΤΟΣ","phi":"","t":[{"t":"αιματόχορτο","d":"150-200","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"Μουχρίτσα","d":"150-200","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"πράσινη σετάρια","d":"150-200","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"πάνικο","d":"150-200","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"βέλιουρας από σπόρο","d":"150-200","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"αγριομπαμπακιά","d":"150-200","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"τραχύ βλήτο","d":"150-200","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"καψέλλα","d":"150-200","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"λουβουδιά","d":"150-200","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"τάτουλας","d":"150-200","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"μεγαλόκαρπη κολλητσίδα","d":"150-200","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"σκαρολάχανο","d":"150-200","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"αγριοπιπεριά","d":"150-200","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"γλυστρίδα (αντράκλα)","d":"150-200","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"μαρτιάκος","d":"150-200","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"αγριοντοματιά, στύφνος","d":"150-200","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"ζωχός","d":"150-200","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"Στελλάρια","d":"