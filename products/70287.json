{"f":"70287","n":"SULCOTREK SC","as":[{"n":"Terbuthylazine","p":"32.7"},{"n":"Sulcotrione","p":"17.3"}],"k":"HB","kn":"ΖΙΖΑΝΙΟΚΤΟΝΟ","m":"SC","s":"Εκλεκτικό προφυτρωτικό-μεταφυτρωτικό ζιζανιοκτόνο για την καταπολέμηση κυρίως πλατύφυλλων και ορισμένων αγρωστωδών ζιζανίων στην καλλιέργεια του αραβοσίτου. Απορροφάται από τα φύλλα και τις ρίζες των ζιζανίων. Είναι μίγμα της δραστικής ουσίας sulcotrione που ανήκει στην ομάδα των τρικετονών και της δραστικής ουσίας terbuthylazine που ανήκει στην ομάδα των χλωροτριαζινών. Το sulcotrione παρεμποδίζει τη βιοσύνθεση των καροτινοειδών ενώ το terbuthylazine αναστέλλει την φωτοσύνθεση και την αναπνοή.","crops":[{"c":"1011000","n":"ΑΡΑΒΟΣΙΤΟΣ","phi":"","t":[{"t":"αιματόχορτο","d":"200-260","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"Μουχρίτσες","d":"200-260","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"Μουχρίτσα","d":"200-260","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"αγριομπαμπακιά","d":"200-260","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"άσπρο βλήτο","d":"200-260","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"τραχύ βλήτο","d":"200-260","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"καψέλλα","d":"200-260","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"λουβουδιά","d":"200-260","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"τάτουλας","d":"200-260","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"σκαρολάχανο","d":"200-260","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"αγριοπιπεριά","d":"200-260","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"γλυστρίδα (αντράκλα)","d":"200-260","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"αγριοντοματιά, στύφνος","d":"200-260","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"Αγριομελιτζάνα","d":"200-260","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"βλήτα","d":"200-260","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"}]}],"docs":[{"d":"2026-07-15","t":"Τροποποίηση — παρασκευαστές της δραστικής ουσίας, εργοστάσια παρασκευής, εργοστάσια συσκευασίας","u":"https://1click.minagric.gr/oneClickUI/oneClickFiles/SULCOTREK-SC-tr26-par-do-par-erg-par-sysk-70287.pd