{"f":"61199","n":"PECARI 300 EC","as":[{"n":"Prothioconazole","p":"30.0"}],"k":"FU","kn":"ΜΥΚΗΤΟΚΤΟΝΟ","m":"EC","s":"Διασυστηματικό μυκητοκτόνο με δραστική ουσία prothioconazole της ομάδας των DMIs, (υποομάδα triazolinthiones), με προληπτική, θεραπευτική και εξοντωτική δράση σε ευρύ φάσμα μυκήτων σε καλλιέργειες χειμερινών και ανοιξιάτικων σιτηρών. Σε βιοχημικό επίπεδο η δραστική ουσία prothioconazole δρα παρεμποδίζοντας τη βιοσύνθεση εργοστερόλης στη θέση της απομεθυλίωσης του C-14 (Demethylation Inhibitors- DMIs). Το prothioconazole παρέχει προστασία πριν και μετά την μόλυνση του φυτού από το παθογόνο. Απορροφάται γρήγορα από τους ιστούς του φυτού και μετακινείται στο φυτό μέσω των αγγείων του ξύλου (ακροπέταλη διασυστηματική κίνηση) προς τα νεαρά αναπτυσσόμενα όργανα.","crops":[{"c":"1011800","n":"ΑΓΡΙΟΣΙΤΑΡΟ ή ΌΛΥΡΑ ή ΖΕΑ ή ΣΠΕΛΤΑ","phi":"35.0","t":[{"t":"Καστανή σκωρίαση","d":"65","u":"κυβ.εκ./στρέμμα","c":"Ασθένειες (μύκητες και βακτήρια)"},{"t":"Δικτυωτή κηλίδωση","d":"65","u":"κυβ.εκ./στρέμμα","c":"Ασθένειες (μύκητες και βακτήρια)"},{"t":"Ελμινθοσπορίωση","d":"65","u":"κυβ.εκ./στρέμμα","c":"Ασθένειες (μύκητες και βακτήρια)"}]},{"c":"1010302","n":"ΚΡΙΘΑΡΙ ΑΝΟΙΞΙΑΤΙΚΟ","phi":"35.0","t":[{"t":"Καστανή σκωρίαση","d":"65","u":"κυβ.εκ./στρέμμα","c":"Ασθένειες (μύκητες και βακτήρια)"},{"t":"Δικτυωτή κηλίδωση","d":"65","u":"κυβ.εκ./στρέμμα","c":"Ασθένειες (μύκητες και βακτήρια)"}]},{"c":"1010303","n":"ΚΡΙΘΑΡΙ ΧΕΙΜΕΡΙΝΟ","phi":"35.0","t":[{"t":"Καστανή σκωρίαση","d":"65","u":"κυβ.εκ./στρέμμα","c":"Ασθένειες (μύκητες και βακτήρια)"},{"t":"Δικτυωτή κηλίδωση","d":"65","u":"κυβ.εκ./στρέμμα","c":"Ασθένειες (μύκητες και βακτήρια)"}]},{"c":"1012005","n":"ΣΙΤΑΡΙ ΜΑΛΑΚΟ ΑΝΟΙΞΙΑΤΙΚΟ","phi":"35.0","t":[{"t":"Σεπτορίωση","d":"65","u":"κυβ.εκ./στρέμμα","c":"Ασθένειες (μύκητες και βακτήρια)"},{"t":"Φουζάριο","d":"65","u":"κυβ.εκ./στρέμμα","c":"Ασθένειες (μύκητες και βακτήρια)"}]},{"c":"1012006","n":"ΣΙΤΑΡΙ ΜΑΛΑΚΟ ΧΕΙΜΕΡΙΝΟ","phi":"35.0","t":[{"t":"Καστανή σκωρίαση","d":"65","u":"κ