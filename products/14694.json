{"f":"14694","n":"LEBRON 0,5 GR","as":[{"n":"Tefluthrin","p":"0.5"}],"k":"IN","kn":"ΕΝΤΟΜΟΚΤΟΝΟ","m":"GR","s":"Πυρεθρινοειδές εντοµοκτόνο. Καταπολεµά έντοµα εδάφους. Παρεµποδίζει τη λειτουργία των διαύλων ιόντων νατρίου (sodium channel modulator) προκαλώντας παρατεταµένο άνοιγµα αυτών που οδηγεί σε υπερευαισθησία του νευρικού συστήµατος, διακοπή της διατροφής, παράλυση και τελικά το θάνατο του εντόµου. ∆ρα δι’ επαφής µέσω της απορρόφησής του από την επιδερµίδα, αλλά έχει και κάποια δράση δια του στοµάχου. ∆εν είναι διασυστηµατικό αλλά έχει δράση µε ατµούς. Έχει γρήγορη αρχική δράση (knockdown effect) και αρκετή υπολειµµατική διάρκεια. Επιπλέον, λόγω των ατµών που δηµιουργούνται στην εδαφική ζώνη, τα έντοµα αποµακρύνονται και δεν πλησιάζουν τα φυτά στη γραµµή εφαρµογής.","crops":[{"c":"1011000","n":"ΑΡΑΒΟΣΙΤΟΣ","phi":"","t":[{"t":"Σιδηροσκούληκα","d":"1200-1500","u":"g/στρέμμα","c":"Έντομα"},{"t":"Αγρότιδα ή καραφατμέ","d":"1200-1500","u":"g/στρέμμα","c":"Έντομα"},{"t":"Διαβρώτικα","d":"1200-1500","u":"g/στρέμμα","c":"Έντομα"},{"t":"Υλεμύια","d":"1200-1500","u":"g/στρέμμα","c":"Έντομα"},{"t":"Scutigerella immaculata","d":"1200-1500","u":"g/στρέμμα","c":"Λοιποί οργανισμοί"},{"t":"Tipula sp.","d":"1200-1500","u":"g/στρέμμα","c":"Έντομα"},{"t":"Agriotes sp.","d":"1200-1500","u":"","c":"Έντομα"},{"t":"Agrotis sp.","d":"1200-1500","u":"","c":"Έντομα"},{"t":"Diabrotica sp.","d":"1200-1500","u":"","c":"Έντομα"},{"t":"Hylemya sp.","d":"1200-1500","u":"","c":"Έντομα"},{"t":"Scutigerella immaculata","d":"1200-1500","u":"","c":"Λοιποί οργανισμοί"},{"t":"Tipula sp.","d":"1200-1500","u":"","c":"Έντομα"}]},{"c":"1030300","n":"ΒΑΜΒΑΚΙ","phi":"","t":[{"t":"Σιδηροσκούληκα","d":"1000-1500","u":"g/στρέμμα","c":"Έντομα"},{"t":"Αγρότιδα ή καραφατμέ","d":"1000-1500","u":"g/στρέμμα","c":"Έντομα"},{"t":"Αλτης","d":"1000-1500","u":"g/στρέμμα","c":"Έντομα"},{"t":"Υλεμύια","d":"1000-1500","u":"g/στρέμμα","c":"Έντομα"},{"t":"Agriotes sp.","d":"1000-1500","u":"","c":"Έντομα"},{"t":"Agrotis sp.",