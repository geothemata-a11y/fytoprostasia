{"f":"70159","n":"BORDER","as":[{"n":"Mesotrione","p":"10.0"}],"k":"HB","kn":"ΖΙΖΑΝΙΟΚΤΟΝΟ","m":"SC","s":"Μεταφυτρωτικό εκλεκτικό ζιζανιοκτόνο για την καταπολέμηση ετησίων πλατύφυλλων ζιζανίων στον αραβόσιτο. Το Border 100 SC περιέχει το δραστικό συστατικό Mesotrione το οποίο ανήκει στην ομάδα των Τρικετονών. Δρα παρεμποδίζοντας τη βιοσύνθεση των καροτινοειδών με δράση στο ένζυμο 4-ΗΡΡD. Απορροφάται ταχέως κυρίως από το φύλλωμα και μεταφέρεται στους αναπτυσόμενους μέρη. Σε διάτημα 5 έως 7 ημερών θα εμφανισθούν τα πρώτα συμπτώματα λεύκανσης των ζιζανίων. Πλήρης καταστροφή επέρχεται μετά από 14 ημέρες.","crops":[{"c":"1011000","n":"ΑΡΑΒΟΣΙΤΟΣ","phi":"","t":[{"t":"αιματόχορτο","d":"150","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"Μουχρίτσα","d":"150","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"αγριομπαμπακιά","d":"50-100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"βλήτο","d":"50-100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"καψέλλα","d":"50-100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"λουβουδιά","d":"50-100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"ψαλίδα","d":"50-100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"μεγαλόκαρπη κολλητσίδα","d":"50-100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"πολυκόμπι","d":"50-100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"λαπάτσα","d":"50-100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"αγριοπιπεριά","d":"50-100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"περικοκλάδα ετήσια","d":"50-100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"ραπανίδα","d":"50-100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"άγριο σινάπι","d":"50-100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"αγριοντοματιά, στύφνος","d":"50-100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"Στελλάρια","d":"50-100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"Πανσές","d":"50-100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"Αγκαθι","d":"50-100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"καλινσόγκα","d":"50-100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"}]}],"docs":[{"d":"2021-11-11","t":"Τροπ