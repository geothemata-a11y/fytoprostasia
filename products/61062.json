{"f":"61062","n":"ORONDIS ULTRA 3/25 SC","as":[{"n":"Oxathiapiprolin","p":"3.0"},{"n":"Mandipropamid","p":"25.0"}],"k":"FU","kn":"ΜΥΚΗΤΟΚΤΟΝΟ","m":"SC","s":"Μυκητοκτόνο με προληπτική και προστατευτική δράση για την καταπολέμηση του περονόσπορου. Η δ.ο. oxathiapiprolin κινείται διελασματικά συμβάλλοντας στην ομοιόμορφη προστασία του φυλλώματος και διασυστηματικά, μέσω του ξυλώματος, προστατεύοντας την νέα βλάστηση. Δρα ως ρυθμιστής δέσμευσης της οξυστερόλης (OSBPΙ) στα κύτταρα των μυκήτων διαταράσσοντας κυτταρικές λειτουργίες όπως η σηματοδότηση, η διατήρηση των κυτταρικών μεμβρανών και ο σχηματισμός λιπιδίων απαραίτητων για την επιβίωση των μυκήτων. Η δ.ο. mandipropamid απορροφάται από τους φυτικούς ιστούς και κινείται διελασματικά παρεμποδίζοντας την βλάστηση των σπορίων, την ανάπτυξη του μυκηλίου και τη σποριογέννεση.","crops":[{"c":"1140300","n":"ΑΜΠΕΛΙ ΕΠΙΤΡΑΠΕΖΙΕΣ","phi":"21.0","t":[{"t":"Περονόσπορος","d":"67","u":"κυβ.εκ./στρέμμα","c":"Ασθένειες (μύκητες και βακτήρια)"}]},{"c":"1140100","n":"ΑΜΠΕΛΙ ΟΙΝΟΠΟΙΗΣΙΜΕΣ","phi":"21.0","t":[{"t":"Περονόσπορος","d":"67","u":"κυβ.εκ./στρέμμα","c":"Ασθένειες (μύκητες και βακτήρια)"}]},{"c":"1051500","n":"ΚΡΕΜΜΥΔΙΑ ΥΠΑΙΘΡΟΥ","phi":"7.0","t":[{"t":"Περονόσπορος","d":"60","u":"κυβ.εκ./στρέμμα","c":"Ασθένειες (μύκητες και βακτήρια)"}]},{"c":"1061000","n":"ΜΑΡΟΥΛΙ ΘΕΡΜΟΚΗΠΙΟΥ","phi":"7.0","t":[{"t":"Περονόσπορος","d":"40","u":"κυβ.εκ./στρέμμα","c":"Ασθένειες (μύκητες και βακτήρια)"}]},{"c":"1067000","n":"ΜΑΡΟΥΛΙ ΚΑΤΣΑΡΟ ΘΕΡΜΟΚΗΠΙΟΥ","phi":"7.0","t":[{"t":"Περονόσπορος","d":"40","u":"κυβ.εκ./στρέμμα","c":"Ασθένειες (μύκητες και βακτήρια)"}]},{"c":"1059000","n":"ΜΑΡΟΥΛΙ ΚΑΤΣΑΡΟ ΥΠΑΙΘΡΟΥ","phi":"7.0","t":[{"t":"Περονόσπορος","d":"40","u":"κυβ.εκ./στρέμμα","c":"Ασθένειες (μύκητες και βακτήρια)"}]},{"c":"1051901","n":"ΜΑΡΟΥΛΙ ΛΕΙΟ, ΚΕΦΑΛΩΤΟ ΥΠΑΙΘΡΟΥ","phi":"7.0","t":[{"t":"Περονόσπορος","d":"40","u":"κυβ.εκ./στρέμμα","c":"Ασθένειες (μύκητες και βακτήρια)"}]},{"c":"1051902","n":"ΜΑΡΟΥΛΙ ΣΤΡΟΓΓΥΛΟ (ΣΑΛΑΤΑ) ΥΠΑΙΘΡΟΥ","phi":"7.0","t":[