{"f":"70049","n":"FOXTROT 6,9 EW","as":[{"n":"Fenoxaprop-P","p":"6.9"}],"k":"HB","kn":"ΖΙΖΑΝΙΟΚΤΟΝΟ","m":"EW","s":"Μεταφυτρωτικό διασυστηματικό ζιζανιοκτόνο για την καταπολέμηση αγρωστωδών ζιζανίων σε σιτάρι και κριθάρι. Το FOXTROT 6,9 EW απορροφάται κυρίως από τα φύλλα και τον βλαστό και μεταφέρεται στις ρίζες και τα ριζώματα. Μετά την εφαρμογή οι νεότεροι ιστοί των φύλλων γίνονται χλωρωτικοί (κίτρινοι) ή νεκρωτικοί (καφέ) και τα φύλλα αποσχίζονται εύκολα. Το τελικό αποτέλεσμα είναι η νέκρωση των ζιζανίων.","crops":[{"c":"1010300","n":"ΚΡΙΘΑΡΙ","phi":"","t":[{"t":"φάλαρη","d":"100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"αλεπονουρές","d":"100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"Ανεμόχορτο","d":"100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"Αγριοβρώμες","d":"100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"σετάρια","d":"100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"τραχεία λειβαδοπόα","d":"100","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"}]},{"c":"1012100","n":"ΣΙΤΑΡΙ ΜΑΛΑΚΟ","phi":"","t":[{"t":"φάλαρη","d":"100-120","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"αλεπονουρές","d":"100-120","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"Ανεμόχορτο","d":"100-120","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"Αγριοβρώμες","d":"100-120","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"σετάρια","d":"100-120","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"τραχεία λειβαδοπόα","d":"100-120","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"}]},{"c":"1012200","n":"ΣΙΤΑΡΙ ΣΚΛΗΡΟ","phi":"","t":[{"t":"φάλαρη","d":"100-120","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"αλεπονουρές","d":"100-120","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"Ανεμόχορτο","d":"100-120","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"Αγριοβρώμες","d":"100-120","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"σετάρια","d":"100-120","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"},{"t":"τραχεία λειβαδοπόα","d":"100-120","u":"κυβ.εκ./στρέμμα","c":"Ζιζάνια"}]}],"docs":[{"d":"2026-05-08","t":"Τροποποίηση — ημερομηνία λήξης","u":"https://1click.minagric.gr/oneClic