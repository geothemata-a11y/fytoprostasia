{"f":"14857","n":"TEKTON","as":[{"n":"Tefluthrin","p":"1.5"}],"k":"IN","kn":"ΕΝΤΟΜΟΚΤΟΝΟ","m":"GR","s":"Πυρεθρινοειδές εντομοκτόνο. Καταπολεμά έντομα εδάφους. Παρεμποδίζει τη λειτουργία των διαύλων ιόντων νατρίου (sodium channel modulator) προκαλώντας παρατεταμένο άνοιγμα αυτών που οδηγεί σε υπερευαισθησία του νευρικού συστήματος, διακοπή της διατροφής, παράλυση και τελικά το θάνατο του εντόμου. Δρα δια της επαφής μέσω της απορρόφησής του από την επιδερμίδα, αλλά έχει και κάποια δράση δια του στομάχου. Δεν είναι διασυστηματικό αλλά έχει δράση με ατμούς. Έχει γρήγορη αρχική δράση (knockdown effect) και αρκετή υπολειμματική διάρκεια. Επιπλέον, λόγω των ατμών που δημιουργούνται στην εδαφική ζώνη, τα έντομα απομακρύνονται και δεν πλησιάζουν τα φυτά στη γραμμή εφαρμογής.","crops":[{"c":"1011000","n":"ΑΡΑΒΟΣΙΤΟΣ","phi":"","t":[{"t":"Σιδηροσκούληκα","d":"350-500","u":"g/στρέμμα","c":"Έντομα"},{"t":"Αγρότιδα ή καραφατμέ","d":"350-500","u":"g/στρέμμα","c":"Έντομα"},{"t":"Diabrotica virgifera LECONTE","d":"1220","u":"g/στρέμμα","c":"Έντομα"},{"t":"Scutigerella immaculata","d":"350-500","u":"g/στρέμμα","c":"Λοιποί οργανισμοί"},{"t":"Agriotes sp.","d":"350-500","u":"","c":"Έντομα"},{"t":"Agrotis sp.","d":"350-500","u":"","c":"Έντομα"},{"t":"Diabrotica virgifera LECONTE","d":"1220","u":"","c":"Έντομα"},{"t":"Scutigerella immaculata","d":"350-500","u":"","c":"Λοιποί οργανισμοί"}]},{"c":"1030300","n":"ΒΑΜΒΑΚΙ","phi":"","t":[{"t":"Σιδηροσκούληκα","d":"350-500","u":"g/στρέμμα","c":"Έντομα"},{"t":"Αγρότιδα ή καραφατμέ","d":"350-500","u":"g/στρέμμα","c":"Έντομα"},{"t":"Agriotes sp.","d":"350-500","u":"","c":"Έντομα"},{"t":"Agrotis sp.","d":"350-500","u":"","c":"Έντομα"}]},{"c":"1034300","n":"ΖΑΧΑΡΟΤΕΥΤΛΑ","phi":"","t":[{"t":"Σιδηροσκούληκα","d":"350-500","u":"g/στρέμμα","c":"Έντομα"},{"t":"Αγρότιδα ή καραφατμέ","d":"350-500","u":"g/στρέμμα","c":"Έντομα"},{"t":"Agriotes sp.","d":"350-500","u":"","c":"Έντομα"},{"t":"Agrotis sp.","d":"350-500","u":"","c":"Έντομα"}]},{"c":"1031000","n":"Κ